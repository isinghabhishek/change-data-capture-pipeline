# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sourcedb

# CDC replication user
CDC_DB_USER=cdc_user
CDC_DB_PASSWORD=changeme

# MinIO object storage
